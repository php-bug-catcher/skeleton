{
    "controllers": {
      "@symfony/ux-live-component": {
        "live": {
          "enabled": true,
          "fetch": "eager",
          "autoimport": {
            "@symfony/ux-live-component/dist/live.min.css": true
          }
        }
      },
        "@symfony/ux-turbo": {
            "turbo-core": {
                "enabled": true,
                "fetch": "eager"
            },
            "mercure-turbo-stream": {
                "enabled": false,
                "fetch": "eager"
            }
        },
      "@tito10047/persistent-state-bundle": {
        "selection": {
          "enabled": true,
          "fetch": "eager"
        }
        }
    },
    "entrypoints": []
}
